{
  "refreshInterval": {
    "type": "spinbutton",
    "default": 60,
    "min": 5,
    "max": 3600,
    "step": 5,
    "description": "Refresh interval (seconds)"
  },

  "apiChoice": {
    "type": "radiogroup",
    "description": "Select API",
    "options": {
      "Joke API": "jokeapi",
      "Official Jokes": "officialjoke",
      "Icanhazdadjoke": "icanhazdadjoke"
    },
    "default": "jokeapi"
  },
  "jokeCategory": {
    "type": "combobox",
    "default": "Any",
    "description": "Joke category",
    "dependency": "apiChoice=jokeapi",
    "options": {
      "Any": "Any",
      "Programming": "Programming",
      "Misc": "Misc",
      "Dark": "Dark",
      "Pun": "Pun"
    }
  }
}